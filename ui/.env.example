# SDR Command Center Configuration

# ===========================================
# Keycloak Authentication (OIDC)
# ===========================================
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=sdr
VITE_KEYCLOAK_CLIENT_ID=lovable-web
# Optional: Override redirect URI (defaults to window.location.origin)
# VITE_KEYCLOAK_REDIRECT_URI=http://localhost:5173

# ===========================================
# Backend API
# ===========================================
VITE_API_BASE_URL=http://localhost:8090
VITE_WS_BASE_URL=ws://localhost:8090

# ===========================================
# Feature Flags
# ===========================================
# Set to 'true' to use mock authentication (bypasses Keycloak)
# Enable this for local development without a Keycloak server
VITE_MOCK_AUTH=true
# Set to 'true' to use mock API data
VITE_MOCK_API=false
